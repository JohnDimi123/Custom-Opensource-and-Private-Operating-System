/* AuroraOS rofi config - acts as the "Win+S" search/launcher overlay. */
configuration {
  modi:                "drun,run,window";
  show-icons:          true;
  font:                "Inter 11";
  display-drun:        "Search";
  display-window:      "Windows";
  drun-display-format: "{name}";
  terminal:            "xfce4-terminal";
  icon-theme:          "Aurora";
}

* {
  bg:        #1c1c22ee;
  bg-alt:    #25252d;
  fg:        #ececec;
  fg-dim:    #b8b8be;
  border:    #3a3a45;
  accent:    #4cc2ff;
  accent-fg: #0a0a0e;
}

window {
  background-color: @bg;
  border:           1px;
  border-color:     @border;
  border-radius:    14px;
  padding:          16px;
  width:            560px;
  location:         center;
  anchor:           center;
}

mainbox { spacing: 12px; }

inputbar {
  children:          [ prompt, entry ];
  background-color:  @bg-alt;
  text-color:        @fg;
  padding:           10px 12px;
  border-radius:     10px;
  spacing:           8px;
}

prompt { text-color: @fg-dim; }
entry  { text-color: @fg; placeholder: "Type to search apps, files, settings"; placeholder-color: @fg-dim; }

listview { lines: 8; columns: 1; spacing: 4px; cycle: true; dynamic: true; layout: vertical; }

element {
  padding: 8px 10px;
  border-radius: 8px;
  text-color: @fg;
  background-color: transparent;
  spacing: 10px;
}
element selected            { background-color: @accent; text-color: @accent-fg; }
element-icon                { size: 24px; background-color: transparent; }
element-text                { vertical-align: 0.5; }
