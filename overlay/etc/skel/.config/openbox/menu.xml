<?xml version="1.0" encoding="UTF-8"?>
<!--
  AuroraOS Openbox right-click desktop menu.
  Fallback for when tint2 isn't running yet.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="apps-internet" label="Internet">
    <item label="Chromium"><action name="Execute"><command>chromium</command></action></item>
  </menu>

  <menu id="apps-system" label="System">
    <item label="Settings">      <action name="Execute"><command>aurora-settings</command></action></item>
    <item label="About AuroraOS"><action name="Execute"><command>aurora-about</command></action></item>
    <item label="Welcome">       <action name="Execute"><command>aurora-welcome</command></action></item>
    <item label="Install to disk"><action name="Execute"><command>sudo -E calamares</command></action></item>
  </menu>

  <menu id="apps-utilities" label="Utilities">
    <item label="Files (PCManFM)"><action name="Execute"><command>pcmanfm</command></action></item>
    <item label="Terminal">       <action name="Execute"><command>xfce4-terminal</command></action></item>
    <item label="Calculator">     <action name="Execute"><command>galculator</command></action></item>
    <item label="Text editor">    <action name="Execute"><command>mousepad</command></action></item>
    <item label="Screenshot">     <action name="Execute"><command>gnome-screenshot -i</command></action></item>
  </menu>

  <menu id="root-menu" label="Aurora">
    <item label="Search apps...">
      <action name="Execute"><command>rofi -show drun</command></action>
    </item>
    <separator/>
    <menu id="apps-internet"/>
    <menu id="apps-system"/>
    <menu id="apps-utilities"/>
    <separator/>
    <item label="Reload taskbar">
      <action name="Execute"><command>sh -c "killall tint2 picom feh dunst 2>/dev/null; sleep 0.3; ~/.config/openbox/autostart"</command></action>
    </item>
    <separator/>
    <item label="Restart desktop"><action name="Restart"/></item>
    <item label="Log out">        <action name="Exit"><prompt>yes</prompt></action></item>
    <item label="Reboot">         <action name="Execute"><command>systemctl reboot</command></action></item>
    <item label="Shutdown">       <action name="Execute"><command>systemctl poweroff</command></action></item>
  </menu>

</openbox_menu>
