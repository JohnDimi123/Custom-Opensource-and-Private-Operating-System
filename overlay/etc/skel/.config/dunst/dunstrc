[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 120
    origin = bottom-right
    offset = 16x70
    notification_limit = 6
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 320

    indicate_hidden = yes
    transparency = 8
    separator_height = 1
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#3a3a45"
    separator_color = "#3a3a45"

    sort = yes
    idle_threshold = 120

    font = Inter 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 0
    max_icon_size = 48
    icon_path = /usr/share/icons/Aurora/scalable/status:/usr/share/icons/Adwaita/scalable/status

    sticky_history = yes
    history_length = 30

    dmenu = /usr/bin/rofi -dmenu
    browser = /usr/bin/xdg-open

    title = Dunst
    class = Dunst
    corner_radius = 12

[urgency_low]
    background = "#1c1c22"
    foreground = "#b8b8be"
    timeout = 6

[urgency_normal]
    background = "#1c1c22"
    foreground = "#ececec"
    timeout = 8

[urgency_critical]
    background = "#1c1c22"
    foreground = "#ff5d6c"
    frame_color = "#ff5d6c"
    timeout = 0
