[Unit]
Description=JARVIS Voice Engine (wake word, STT, TTS)
After=jarvis-core.service sound.target
Wants=jarvis-core.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/jarvis
EnvironmentFile=-/etc/jarvis/jarvis.env
ExecStart=/usr/bin/python3 /opt/jarvis/jarvis_voice/voice.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
