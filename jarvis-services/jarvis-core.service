[Unit]
Description=JARVIS Core Orchestrator
After=network.target jarvis-prep.service
Wants=jarvis-prep.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/jarvis
Environment=JARVIS_USER=operator
EnvironmentFile=-/etc/jarvis/jarvis.env
ExecStart=/usr/bin/python3 /opt/jarvis/jarvis_core/core.py
Restart=always
RestartSec=2
RuntimeDirectory=jarvis
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
